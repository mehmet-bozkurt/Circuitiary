{
  "name": "circuitiary",
  "version": "0.1.0",
  "description": "Interactive teaching notebook for small neuron circuits: parameterised rate model, 2D/3D views, lessons and a circuit builder (Turkish UI); optional C. elegans connectome subgraph from locally imported data · Sinir devrelerini kurarak öğrenmek için etkileşimli deney defteri",
  "keywords": [
    "neuroscience",
    "connectome",
    "c-elegans",
    "neural-circuits",
    "education",
    "turkish",
    "simulation",
    "vue",
    "typescript",
    "visualization"
  ],
  "license": "MIT",
  "author": "Mehmet Bozkurt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehmet-bozkurt/Circuitiary.git"
  },
  "bugs": {
    "url": "https://github.com/mehmet-bozkurt/Circuitiary/issues"
  },
  "homepage": "https://mehmet-bozkurt.github.io/Circuitiary/",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "playwright test",
    "test:pages": "playwright test --config=playwright.pages.config.ts",
    "test:evidence": "CIRCUITIARY_EVIDENCE_DIR=test-results/evidence-$(date +%Y%m%d-%H%M%S) playwright test"
  },
  "dependencies": {
    "cytoscape": "3.34.3",
    "three": "0.186.1",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
